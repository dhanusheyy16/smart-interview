# Flask Configuration
SECRET_KEY=smart-interview-super-secret-key-1337

# Azure OpenAI Configuration (Required for AI deep reports)
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# Optional: Azure Speech Service (For cloud-based Speech-to-Text transcription)
# If set to true, configure key and region. Otherwise, default free Google Speech Recognition is used.
USE_AZURE_SPEECH=false
AZURE_SPEECH_KEY=your_azure_speech_service_key_here
AZURE_SPEECH_REGION=eastus
